; Living Dungeon — Godot 4
config_version=5

[application]
config/name="Dungeon Living"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Un dungeon persistente de exploración y combate en tiempo real."

[display]
window/size/viewport_width=480
window/size/viewport_height=300
window/size/window_width_override=960
window/size/window_height_override=600
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.035, 0.06, 1)
